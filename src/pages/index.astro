---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { LINE_URL, PROTECT_URL } from '../consts';
import OfficialChannels from '../components/OfficialChannels.astro';
import { personSchema, websiteSchema } from '../lib/schema';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title="Ted ｜ 財務教練 — 把房子算進你的理財規劃"
  description="沈裕德 Ted，軟體工程師出身的財務教練。陪有房族把房子和錢放在一起算——它能給你什麼，還剩幾個選項。不推銷，先把事情講清楚。"
  ogTitle="Ted ｜ 財務教練"
  ogDescription="把房子算進你的理財規劃。它能給你什麼，還剩幾個選項。"
  path="/"
  schema={[personSchema(), websiteSchema()]}
>
  <!-- ① Hero：左文右圖 -->
  <header class="hero2 wrap-wide">
    <div class="hero2-text">
      <p class="eyebrow">GROW ｜ 財務教練</p>
      <h1 class="serif">多數人的理財規劃<br />漏掉了資產裡最大的那一項</h1>
      <p class="hero2-lead">我是沈裕德 Ted，軟體工程師出身的財務教練。陪你把房子和錢放在一起算——它能給你什麼，還剩幾個選項。不急著推你買什麼，先把事情講清楚。</p>
      <div class="btn-row">
        <a class="btn btn-line" href={LINE_URL}>加我的 LINE，聊聊你的狀況 →</a>
        <a class="btn btn-ghost" href="/blog/">先看文章</a>
      </div>
    </div>
    <div class="hero2-side">
      <img class="portrait" src="/avatar.jpg" alt="沈裕德 Ted，財務教練" width="848" height="1248" fetchpriority="high" />
      <div class="free-card">
        <strong>第一次諮詢，免費</strong>
        <span>一杯咖啡的時間，先把你的財務狀況聊清楚。沒有壓力，不聊也沒關係。</span>
      </div>
    </div>
  </header>

  <!-- ② 服務：深綠帶 -->
  <section class="green-band" id="services">
    <div class="wrap-wide">
      <div class="band-head">
        <div>
          <p class="eyebrow gold-light">給手上有房子的你</p>
          <h2 class="serif h2-big">房子、錢、保障，放在一起算</h2>
        </div>
        <p>這三件事多數人是分開想的。但它們會互相影響——房子綁住多少現金流，決定你能怎麼配置；手上還有多少餘裕，決定保障要補到哪裡。</p>
      </div>
      <div class="grid-3">
        <div class="pillar">
          <span class="serif pnum">01</span>
          <h3>房子怎麼算進來</h3>
          <p>屋齡在走、稅在繳、法規在改，而有些選項會隨時間關掉。先弄清楚你手上這間現在還剩幾條路——繼續住、收租、換掉，或參與改建。</p>
        </div>
        <div class="pillar">
          <span class="serif pnum">02</span>
          <h3>錢怎麼配置</h3>
          <p>手上有一筆錢想讓它有效運用，卻不知道怎麼配置？先把目標和風險攤開，做出你看得懂、睡得著的規劃。</p>
        </div>
        <div class="pillar">
          <span class="serif pnum">03</span>
          <h3>保障怎麼補</h3>
          <p>保險是安全網，不是主角。我具備保險相關專業與證照，會先檢視你現有的保障，找出真正的缺口，再依需求補足，不多買、不亂買。</p>
          <a class="pillar-link" href={`${PROTECT_URL}/`}>保險服務 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ③ 資源對接＋見證 -->
  <section>
    <div class="wrap-wide split">
      <div class="split-text">
        <p class="eyebrow">資源對接</p>
        <h2 class="serif h2-big">完整資源的整合平台</h2>
        <p>涉及資產活化、危老都更、建商合建、土地開發這類案子，我背後有<strong>富足家機構</strong>的整合平台可以對接。如果你另外有一門生意想成長，也能對接新創育成與商業模式資源。這類合作案量身評估、一對一談最清楚。</p>
      </div>
      <figure class="quote-card">
        <span class="serif qmark" aria-hidden="true">“</span>
        <blockquote class="serif">本來只是想問一些投資意見，聽完阿德的介紹，結果規劃更完整。</blockquote>
        <figcaption>— 黃先生，40 歲，上班族</figcaption>
      </figure>
    </div>
  </section>

  <!-- ④ 最新分享 -->
  <section class="tint">
    <div class="wrap-wide">
      <div class="head-row">
        <h2 class="serif h2-big">最新分享</h2>
        <a class="more-link" href="/blog/">看全部文章 →</a>
      </div>
      <div class="grid-3">
        {posts.map((post) => (
          <a class="post-card" href={`/blog/${post.id}/`}>
            <span class="date">{fmt(post.data.pubDate)}</span>
            <h3>{post.data.title}</h3>
            <span class="read">閱讀 →</span>
          </a>
        ))}
      </div>
      <p style="margin-top:24px;"><a class="btn btn-ghost" href="/notes/">Notes・個人學習紀錄 →</a></p>
    </div>
  </section>

  <!-- ⑤ 最終 CTA -->
  <section>
    <div class="wrap-wide">
      <div class="cta-green">
        <div>
          <h2 class="serif">第一次諮詢，免費</h2>
          <p>一杯咖啡的時間，先把你的財務狀況聊清楚。沒有壓力，不聊也沒關係。</p>
        </div>
        <a class="btn btn-line" href={LINE_URL}>加 LINE 預約諮詢 →</a>
      </div>
    </div>
  </section>

  <!-- ⑥ 官方管道與防冒用聲明 -->
  <OfficialChannels />
</Base>

<style>
  section { padding: 88px 0; }
  .eyebrow { color: var(--gold); font-weight: 700; letter-spacing: .12em; font-size: .88rem; margin-bottom: 8px; }
  .gold-light { color: #e3c27a; }
  .h2-big { font-size: clamp(1.6rem, 2.8vw, 2.4rem); font-weight: 900; line-height: 1.35; color: var(--brand-dark); margin-bottom: 0; }
  .btn-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn-line { color: #052e16; }

  .hero2 { display: flex; flex-wrap: wrap; align-items: center; gap: 64px; padding-top: 64px; padding-bottom: 88px; }
  .hero2-text { flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .hero2 h1 { font-size: clamp(2.1rem, 4.2vw, 3.4rem); line-height: 1.3; font-weight: 900; color: var(--brand-dark); }
  .hero2-lead { font-size: 1.12rem; line-height: 1.9; }
  .hero2-side { flex: 1 1 340px; min-width: 0; max-width: 440px; display: flex; flex-direction: column; gap: 16px; }
  .portrait { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 20%; border-radius: 20px; display: block; }
  .free-card { background: var(--bg); border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; display: flex; flex-direction: column; gap: 4px; }
  .free-card strong { color: var(--brand-dark); }
  .free-card span { color: var(--muted); font-size: .92rem; }

  .green-band { background: #1f3a34; color: #f7f5f0; }
  .green-band .h2-big { color: #f7f5f0; }
  .band-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px; margin-bottom: 40px; }
  .band-head > div { flex: 1 1 420px; min-width: 0; }
  .band-head > p { flex: 1 1 380px; min-width: 0; color: #cfd8d3; line-height: 1.9; }
  .pillar { background: #264740; border: 1px solid #37594f; border-radius: 16px; padding: 30px; display: flex; flex-direction: column; gap: 12px; }
  .pillar h3 { font-size: 1.25rem; color: #f7f5f0; }
  .pillar p { color: #cfd8d3; font-size: .97rem; }
  .pnum { font-size: 2rem; color: #e3c27a; line-height: 1; }
  .pillar-link { color: #e3c27a; font-weight: 700; text-decoration: none; }

  .split { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .split-text { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .split-text p { line-height: 1.9; }
  .split-text strong { color: var(--text); }
  .quote-card { flex: 1 1 420px; min-width: 0; background: var(--bg); border: 1px solid var(--border); border-radius: 20px; padding: 36px; display: flex; flex-direction: column; gap: 16px; margin: 0; }
  .qmark { font-size: 3.5rem; line-height: .6; color: #c9a24f; }
  .quote-card blockquote { font-size: 1.35rem; line-height: 1.7; color: var(--brand-dark); }
  .quote-card figcaption { color: var(--muted); font-size: .9rem; }

  .tint { background: var(--surface); }
  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 32px; }
  .more-link { color: var(--brand); font-weight: 700; text-decoration: none; }
  .post-card { background: var(--bg); border: 1px solid var(--border); border-top: 4px solid #c9a24f; border-radius: 16px; padding: 26px; display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--text); transition: transform .15s ease; }
  .post-card:hover { transform: translateY(-2px); }
  .post-card .date { color: var(--muted); font-size: .85rem; }
  .post-card h3 { font-size: 1.12rem; line-height: 1.6; }
  .post-card .read { color: var(--brand); font-weight: 700; font-size: .9rem; margin-top: auto; }

  .cta-green { background: #1f3a34; color: #f7f5f0; border-radius: 24px; padding: 56px 40px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px; }
  .cta-green > div { flex: 1 1 420px; min-width: 0; }
  .cta-green h2 { font-size: clamp(1.6rem, 2.8vw, 2.4rem); margin-bottom: 10px; }
  .cta-green p { color: #cfd8d3; }

  @media (prefers-color-scheme: dark) {
    .h2-big, .hero2 h1, .free-card strong, .quote-card blockquote { color: var(--text); }
  }
  @media (max-width: 560px) {
    section { padding: 64px 0; }
    .hero2 { padding-top: 32px; gap: 40px; }
    .cta-green { padding: 40px 24px; }
  }
</style>
