---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { LINE_URL } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title="Ted ｜ 財務教練 — 讓你的錢有方向"
  description="沈裕德 Ted，軟體工程師出身的財務教練。不推銷，先陪你把資產活化、投資理財與整體財務看清楚，再決定下一步。"
  ogTitle="Ted ｜ 財務教練"
  ogDescription="軟體工程師出身的財務教練。不推銷，先把事情講清楚。"
  path="/"
>
  <!-- ① Hero：數位名片 -->
  <header class="hero wrap">
    <img class="avatar" src="/avatar.jpg" alt="沈裕德 Ted，財務教練" width="96" height="96" />
    <p class="brand-tag">GROW ｜ 財務教練</p>
    <h1>讓你的錢和資產<br />開始有方向、動起來</h1>
    <p class="lead">我是沈裕德 Ted。資產活化、投資理財——<br />不急著推你買什麼，先陪你把整體財務看清楚，再決定下一步。</p>
    <a class="btn btn-line" href={LINE_URL}>加我的 LINE，聊聊你的狀況 →</a>
  </header>

  <!-- ② 服務 Zone 1：個人 / 家庭 -->
  <section class="wrap" id="services">
    <p class="zone-label">給想理財的你</p>
    <h2>個人與家庭，我可以這樣陪你</h2>
    <div class="cards">
      <div class="card">
        <div class="num">01</div>
        <h3>投資理財 & 財務諮商</h3>
        <p>手上有一筆錢想讓它有效運用，卻不知道怎麼配置？先把目標和風險攤開，做出你看得懂、睡得著的規劃。</p>
      </div>
      <div class="card">
        <div class="num">02</div>
        <h3>保障規劃</h3>
        <p>有了資產與財務規劃，也別忘了替自己留一張安全網。我具備保險相關專業與證照，會先檢視你現有的保障，找出真正的缺口，再依需求補足，不多買、不亂買，讓保障回到真正需要的地方。</p>
      </div>
    </div>
  </section>

  <!-- ② 服務 Zone 2：地主 / 企業主（進階，簡短） -->
  <section class="wrap">
    <p class="zone-label">給有資產或事業的你</p>
    <h2>資產與事業，放大它的價值</h2>
    <p class="zone-intro">如果你有房、有地，或正在經營自己的事業，資產不一定只是「持有」，也可以成為下一個事業機會的起點。</p>
    <p class="zone-intro">我將以自身的專業與經驗陪你規劃，並結合 <strong>富足家機構</strong> 的資源與整合平台，協助你串聯更多專業、資源與合作機會：</p>
    <ul class="pill-list">
      <li>資產活化 — 讓閒置的房產／土地產生效益</li>
      <li>危老都更・建商合夥・土地開發合建</li>
      <li>新創育成孵化・商業模式資源整合</li>
    </ul>
    <p class="zone-note">這類合作案量身評估、一對一談最清楚，歡迎直接加 LINE 聊你的狀況。</p>
  </section>

  <!-- ③ 見證 -->
  <section class="wrap">
    <h2>他們後來怎麼說</h2>
    <div class="quote">
      <p>「本來只是想問一些投資意見，聽完阿德的介紹，結果規劃更完整。」</p>
      <div class="who">— 黃先生，40 歲，上班族</div>
    </div>
  </section>

  <!-- ④ 最新內容：內容基地入口（自動抓最新三篇，非草稿） -->
  <section class="wrap posts">
    <h2>最新分享</h2>
    {
      posts.map((post) => (
        <a href={`/blog/${post.id}/`}>
          <div>{post.data.title}</div>
          <div class="date">{fmt(post.data.pubDate)}</div>
        </a>
      ))
    }
    <p style="margin-top:20px;"><a href="/blog" style="color:var(--brand);">看全部文章 →</a></p>
  </section>

  <!-- ⑤ 最終 CTA：預約落地 -->
  <section class="wrap">
    <div class="cta">
      <h2>第一次諮詢，免費</h2>
      <p>一杯咖啡的時間，先把你的財務狀況聊清楚。<br />沒有壓力，不聊也沒關係。</p>
      <a class="btn btn-line" href={LINE_URL}>加 LINE 預約諮詢</a>
    </div>
  </section>
</Base>
