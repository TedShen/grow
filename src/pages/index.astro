---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { LINE_URL, PROTECT_URL } from '../consts';
import OfficialChannels from '../components/OfficialChannels.astro';
import { personSchema, websiteSchema } from '../lib/schema';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title="Ted ｜ 財務教練 — 把房子算進你的理財規劃"
  description="沈裕德 Ted，軟體工程師出身的財務教練。陪有房族把房子和錢放在一起算——它能給你什麼，還剩幾個選項。不推銷，先把事情講清楚。"
  ogTitle="Ted ｜ 財務教練"
  ogDescription="把房子算進你的理財規劃。它能給你什麼，還剩幾個選項。"
  path="/"
  schema={[personSchema(), websiteSchema()]}
>
  <!-- ① Hero：數位名片 -->
  <header class="hero wrap">
    <img class="avatar" src="/avatar.jpg" alt="沈裕德 Ted，財務教練" width="96" height="96" fetchpriority="high" />
    <p class="brand-tag">GROW ｜ 財務教練</p>
    <h1>多數人的理財規劃<br />漏掉了資產裡最大的那一項</h1>
    <p class="lead">我是沈裕德 Ted，軟體工程師出身的財務教練。<br />陪你把房子和錢放在一起算——它能給你什麼，還剩幾個選項。<br />不急著推你買什麼，先把事情講清楚。</p>
    <a class="btn btn-line" href={LINE_URL}>加我的 LINE，聊聊你的狀況 →</a>
  </header>

  <!-- ② 服務：房子、錢、保障，放在一起算 -->
  <section class="wrap" id="services">
    <p class="zone-label">給手上有房子的你</p>
    <h2>房子、錢、保障，放在一起算</h2>
    <p class="zone-intro">這三件事多數人是分開想的。但它們會互相影響——房子綁住多少現金流，決定你能怎麼配置；手上還有多少餘裕，決定保障要補到哪裡。</p>
    <div class="cards">
      <div class="card">
        <div class="num">01</div>
        <h3>房子怎麼算進來</h3>
        <p>屋齡在走、稅在繳、法規在改，而有些選項會隨時間關掉。先弄清楚你手上這間現在還剩幾條路——繼續住、收租、換掉，或參與改建。</p>
        <p style="margin-top:14px;">涉及資產活化、危老都更、建商合建、土地開發這類案子，我背後有 <strong>富足家機構</strong> 的整合平台可以對接。</p>
      </div>
      <div class="card">
        <div class="num">02</div>
        <h3>錢怎麼配置</h3>
        <p>手上有一筆錢想讓它有效運用，卻不知道怎麼配置？先把目標和風險攤開，做出你看得懂、睡得著的規劃。</p>
      </div>
      <div class="card">
        <div class="num">03</div>
        <h3>保障怎麼補</h3>
        <p>保險是安全網，不是主角。我具備保險相關專業與證照，會先檢視你現有的保障，找出真正的缺口，再依需求補足，不多買、不亂買。</p>
        <p style="margin-top:14px;"><a class="btn btn-ghost" href={`${PROTECT_URL}/`}>保險服務 →</a></p>
      </div>
    </div>
    <p class="zone-note">如果你另外有一門生意想成長，富足家的整合平台也能對接新創育成與商業模式資源。這類合作案量身評估、一對一談最清楚。</p>
  </section>

  <!-- ③ 見證 -->
  <section class="wrap">
    <h2>他們後來怎麼說</h2>
    <div class="quote">
      <p>「本來只是想問一些投資意見，聽完阿德的介紹，結果規劃更完整。」</p>
      <div class="who">— 黃先生，40 歲，上班族</div>
    </div>
  </section>

  <!-- ④ 最新內容：內容基地入口（自動抓最新三篇，非草稿） -->
  <section class="wrap posts">
    <h2>最新分享</h2>
    {
      posts.map((post) => (
        <a href={`/blog/${post.id}/`}>
          <div>{post.data.title}</div>
          <div class="date">{fmt(post.data.pubDate)}</div>
        </a>
      ))
    }
    <div class="entry-row">
      <a class="btn btn-ghost" href="/blog/">看全部文章 →</a>
      <a class="btn btn-ghost" href="/notes/">Notes・個人學習紀錄 →</a>
    </div>
  </section>

  <!-- ⑤ 官方管道與防冒用聲明 -->
  <OfficialChannels />

  <!-- ⑥ 最終 CTA：預約落地 -->
  <section class="wrap">
    <div class="cta">
      <h2>第一次諮詢，免費</h2>
      <p>一杯咖啡的時間，先把你的財務狀況聊清楚。<br />沒有壓力，不聊也沒關係。</p>
      <a class="btn btn-line" href={LINE_URL}>加 LINE 預約諮詢</a>
    </div>
  </section>
</Base>
